---
import BaseLayout from '@/layouts/BaseLayout.astro';

/**
 * Shared shell for plain-language long-form pages: legal pages
 * (privacy, terms) and guides. Reuses the accessibility statement's
 * look so the pages read as part of the site. Content comes in through
 * the default slot. Set `noindex` to keep a page out of search engines.
 */
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  lede: string;
  updatedLabel: string;
  updatedIso: string;
  noindex?: boolean;
  /** Wider column for pages with tables and code blocks. */
  wide?: boolean;
}
const { title, description, eyebrow, lede, updatedLabel, updatedIso, noindex = false, wide = false } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <section class:list={["section section-y-lg doc-page", { "doc-page--wide": wide }]}>
    <header class="doc-header">
      <p class="section-eyebrow">{eyebrow}</p>
      <h1 class="doc-h1">{title}</h1>
      <p class="doc-lede">{lede}</p>
      <p class="doc-meta">
        <span class="doc-meta-label">Last updated:</span>
        <time datetime={updatedIso}>{updatedLabel}</time>
      </p>
    </header>
    <article class="doc-body">
      <slot />
    </article>
  </section>
</BaseLayout>

<style is:global>
  .doc-page {
    max-width: 760px;
    margin: 0 auto;
  }

  .doc-page--wide {
    max-width: 920px;
  }

  .doc-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(240, 185, 11, 0.15);
  }

  .doc-h1 {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.1;
    margin: 0.75rem 0 1.25rem;
    letter-spacing: 0.01em;
    text-shadow:
      0 1px 0 rgba(0, 0, 0, 0.65),
      0 -1px 0 rgba(240, 185, 11, 0.06);
  }

  .doc-lede {
    color: var(--ink-300);
    font-size: 1.1rem;
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 56ch;
  }

  .doc-meta {
    margin: 0;
    color: var(--ink-500);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .doc-meta-label {
    color: var(--ink-700);
    margin-right: 0.4rem;
  }

  .doc-body {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
    color: var(--ink-300);
    line-height: 1.75;
    font-size: 1rem;
  }

  .doc-body h2 {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    color: var(--ink-100);
    margin: 0 0 1rem;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  .doc-body p {
    margin: 0 0 1rem;
    max-width: 64ch;
  }

  .doc-body p:last-child {
    margin-bottom: 0;
  }

  .doc-body strong {
    color: var(--ink-100);
    font-weight: 600;
  }

  .doc-body a {
    color: var(--gold-300);
    text-decoration: underline;
    text-decoration-color: rgba(240, 185, 11, 0.4);
    text-underline-offset: 3px;
    transition:
      color var(--dur-fast) var(--ease-standard),
      text-decoration-color var(--dur-fast) var(--ease-standard);
  }

  .doc-body a:hover {
    color: var(--gold-200);
    text-decoration-color: var(--gold-300);
  }

  .doc-body code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 0.1em 0.4em;
    background: rgba(240, 185, 11, 0.08);
    border: 1px solid rgba(240, 185, 11, 0.18);
    border-radius: var(--radius-sharp);
    color: var(--ink-100);
  }

  .doc-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .doc-list li {
    position: relative;
    padding-left: 1.5rem;
    line-height: 1.65;
    max-width: 64ch;
  }

  .doc-list li::before {
    content: '◆';
    position: absolute;
    left: 0;
    top: 0.05em;
    color: var(--gold-400);
    font-size: 0.7rem;
  }

  /*
    Visually hidden but still in the accessibility tree —
    "(opens in new tab)" suffixes that screen readers announce
    while sighted users see the icon-free anchor.
  */
  .sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }
</style>
