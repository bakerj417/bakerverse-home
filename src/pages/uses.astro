---
import BaseLayout from '@/layouts/BaseLayout.astro';
import RevealOnScroll from '@/components/islands/RevealOnScroll.tsx';

type Rarity = 'common' | 'uncommon' | 'rare' | 'epic' | 'legendary' | 'artifact';
type Tier = 'mastered' | 'daily' | 'regular' | 'learning';

interface Tool {
  name: string;
  description: string;
  rarity: Rarity;
  tier: Tier;
  href?: string;
  note?: string;
}

interface Category {
  eyebrow: string;
  title: string;
  rune: string;
  tools: Tool[];
}

const categories: Category[] = [
  {
    eyebrow: 'Primary Stack',
    title: 'Languages & Runtimes',
    rune: '⌨',
    tools: [
      {
        name: 'TypeScript',
        description: 'Everything, always. Strict mode, no exceptions.',
        rarity: 'legendary',
        tier: 'mastered',
        href: 'https://www.typescriptlang.org',
      },
      {
        name: 'React & React Native',
        description: 'Web and mobile product work. My day job is React Native on Expo.',
        rarity: 'legendary',
        tier: 'mastered',
        href: 'https://react.dev',
      },
      {
        name: 'Node.js',
        description: 'APIs, CLIs, scripts, and the glue holding everything together.',
        rarity: 'epic',
        tier: 'mastered',
        href: 'https://nodejs.org',
      },
      {
        name: 'Go',
        description: 'Personal projects where I want fast binaries and zero-nonsense concurrency.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://go.dev',
      },
      {
        name: 'Elixir',
        description: 'The one I keep coming back to. Phoenix, LiveView, and the actor model.',
        rarity: 'uncommon',
        tier: 'learning',
        href: 'https://elixir-lang.org',
      },
      {
        name: 'C#',
        description: '.NET when the client ecosystem demands it. LINQ is genuinely good.',
        rarity: 'uncommon',
        tier: 'regular',
      },
    ],
  },
  {
    eyebrow: 'Frontend Craft',
    title: 'UI & Styling',
    rune: '✦',
    tools: [
      {
        name: 'Astro',
        description: 'Static sites and hybrid apps. This site is Astro with React islands.',
        rarity: 'epic',
        tier: 'daily',
        href: 'https://astro.build',
      },
      {
        name: 'Expo',
        description: 'The only sane way to ship React Native to both stores without losing your mind.',
        rarity: 'epic',
        tier: 'mastered',
        href: 'https://expo.dev',
      },
      {
        name: 'Tailwind CSS',
        description: 'Utility-first by default. CSS custom properties for design tokens.',
        rarity: 'epic',
        tier: 'daily',
        href: 'https://tailwindcss.com',
      },
      {
        name: 'GSAP + ScrollTrigger',
        description: 'Scroll-driven animation that actually works cross-browser.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://gsap.com',
      },
      {
        name: 'Framer Motion',
        description: 'React animation layer. Declarative springs and gesture handling.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://www.framer.com/motion',
      },
    ],
  },
  {
    eyebrow: 'Editor & Terminal',
    title: 'The Forge',
    rune: '⚒',
    tools: [
      {
        name: 'Claude Code',
        description: 'AI pair programmer running in the terminal. It wrote most of this page.',
        rarity: 'artifact',
        tier: 'daily',
        href: 'https://claude.ai/code',
        note: 'Max subscription',
      },
      {
        name: 'VS Code',
        description: 'Primary editor. Minimal extensions — mostly TypeScript server and Tailwind IntelliSense.',
        rarity: 'legendary',
        tier: 'mastered',
        href: 'https://code.visualstudio.com',
      },
      {
        name: 'iTerm2 + Zsh',
        description: 'Shell home. Minimal prompt, no framework — just the aliases that matter.',
        rarity: 'epic',
        tier: 'mastered',
        href: 'https://iterm2.com',
      },
      {
        name: 'pnpm',
        description: 'Fast, disk-efficient. Every JS project runs pnpm unless forced otherwise.',
        rarity: 'rare',
        tier: 'daily',
        href: 'https://pnpm.io',
      },
      {
        name: 'Homebrew',
        description: 'The missing package manager for macOS. Installed first on every new machine.',
        rarity: 'rare',
        tier: 'daily',
        href: 'https://brew.sh',
      },
    ],
  },
  {
    eyebrow: 'Design & Creative',
    title: 'Visual Tools',
    rune: '◈',
    tools: [
      {
        name: 'Figma',
        description: 'Design system work, component specs, and anything that needs alignment review.',
        rarity: 'epic',
        tier: 'regular',
        href: 'https://figma.com',
      },
      {
        name: 'Bambu Studio',
        description: '3D print slicer for my Bambu P1S. Where the real prototyping happens.',
        rarity: 'uncommon',
        tier: 'regular',
        href: 'https://bambulab.com/en/software',
        note: 'P1S',
      },
    ],
  },
  {
    eyebrow: 'Infrastructure',
    title: 'Services & Cloud',
    rune: '◆',
    tools: [
      {
        name: 'Vercel',
        description: 'Deploy target for all web projects. Hobby plan does most of what I need.',
        rarity: 'epic',
        tier: 'daily',
        href: 'https://vercel.com',
      },
      {
        name: 'GitHub',
        description: 'Source of truth for every project. Actions for CI, Copilot off.',
        rarity: 'legendary',
        tier: 'mastered',
        href: 'https://github.com',
      },
      {
        name: 'Neon',
        description: 'Serverless Postgres. Branches per PR, instant scale to zero.',
        rarity: 'rare',
        tier: 'daily',
        href: 'https://neon.tech',
      },
      {
        name: 'Sentry',
        description: 'Error monitoring and session replay in production. Scheduled agent fixes issues automatically.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://sentry.io',
      },
      {
        name: 'Cloudflare',
        description: 'DNS, analytics, and Turnstile for bot protection on forms.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://cloudflare.com',
      },
    ],
  },
  {
    eyebrow: 'Knowledge',
    title: 'Notes & Thinking',
    rune: '✶',
    tools: [
      {
        name: 'Obsidian',
        description: 'Local-first, Markdown-native. My dev brain lives here.',
        rarity: 'epic',
        tier: 'daily',
        href: 'https://obsidian.md',
      },
      {
        name: 'Linear',
        description: 'Issue tracking for BSS client work. Fast enough to not get in the way.',
        rarity: 'rare',
        tier: 'regular',
        href: 'https://linear.app',
      },
      {
        name: 'Notion',
        description: 'Client-facing docs and shared workspaces. Not where I think, where I share.',
        rarity: 'uncommon',
        tier: 'regular',
        href: 'https://notion.so',
      },
    ],
  },
];

const tierLabel: Record<Tier, string> = {
  mastered: 'Mastered',
  daily: 'Daily driver',
  regular: 'Regular use',
  learning: 'Learning',
};

const tierClass: Record<Tier, string> = {
  mastered: 'tier--mastered',
  daily: 'tier--daily',
  regular: 'tier--regular',
  learning: 'tier--learning',
};
---

<BaseLayout
  title="Uses"
  description="The tools, languages, hardware, and services that power Joseph Baker's day-to-day engineering work."
>
  <!-- ======================================================
       HERO — monument framing
       ====================================================== -->
  <section class="section section-y-lg uses-intro">
    <div class="monument">
      <div class="monument-frieze monument-frieze--top" aria-hidden="true">
        <span class="monument-rune">⚒</span>
      </div>

      <RevealOnScroll client:visible>
        <div class="uses-heading">
          <p class="section-eyebrow">Codex · Arsenal</p>
          <h1 class="uses-h1 uses-h1--carved">The battle station</h1>
        </div>
        <p class="uses-lede">
          Every tool in active rotation — languages, frameworks, editors,
          services, and the hardware holding it all together. Rarity reflects
          how essential it is to the stack. Tier reflects how deep in I am.
        </p>
      </RevealOnScroll>

      <div class="monument-frieze monument-frieze--bottom" aria-hidden="true">
        <span class="monument-rune">⚒</span>
      </div>
    </div>
  </section>

  <!-- ======================================================
       SKILL TREE — categories
       ====================================================== -->
  <div class="section uses-grid-outer">
    {categories.map((cat, ci) => (
      <section class="uses-category" aria-labelledby={`cat-${ci}`}>
        <RevealOnScroll client:visible>
          <div class="uses-cat-header">
            <span class="uses-cat-rune" aria-hidden="true">{cat.rune}</span>
            <div>
              <p class="section-eyebrow">{cat.eyebrow}</p>
              <h2 class="uses-cat-title" id={`cat-${ci}`}>{cat.title}</h2>
            </div>
          </div>
        </RevealOnScroll>

        <ul class="uses-tool-grid" role="list">
          {cat.tools.map((tool, ti) => (
            <li>
              <RevealOnScroll client:visible delayMs={ti * 60}>
                <div
                  class="uses-tool-card"
                  data-rarity={tool.rarity}
                >
                  <div class="uses-tool-top">
                    <div class="uses-tool-name-row">
                      {tool.href ? (
                        <a
                          href={tool.href}
                          class="uses-tool-name"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {tool.name}
                          {tool.note && (
                            <span class="uses-tool-note">{tool.note}</span>
                          )}
                        </a>
                      ) : (
                        <span class="uses-tool-name">
                          {tool.name}
                          {tool.note && (
                            <span class="uses-tool-note">{tool.note}</span>
                          )}
                        </span>
                      )}
                    </div>
                    <span class={`uses-tier ${tierClass[tool.tier]}`}>
                      {tierLabel[tool.tier]}
                    </span>
                  </div>
                  <p class="uses-tool-desc">{tool.description}</p>
                  <span class="uses-rarity-label">{tool.rarity}</span>
                </div>
              </RevealOnScroll>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <!-- ======================================================
       HARDWARE CALLOUT
       ====================================================== -->
  <section class="section section-y-md uses-hardware-section">
    <RevealOnScroll client:visible>
      <div class="uses-hardware-card">
        <div class="uses-hardware-rune" aria-hidden="true">⌂</div>
        <div class="uses-hardware-body">
          <p class="section-eyebrow">Battle Station</p>
          <h2 class="uses-hardware-title">The physical rig</h2>
          <ul class="uses-hardware-list" role="list">
            <li>
              <span class="uses-hw-label">Primary</span>
              <span class="uses-hw-value">MacBook Pro — MacOS · Apple Silicon</span>
            </li>
            <li>
              <span class="uses-hw-label">Printer</span>
              <span class="uses-hw-value">Bambu Lab P1S — enclosed, multi-material ready</span>
            </li>
            <li>
              <span class="uses-hw-label">NAS</span>
              <span class="uses-hw-value">Synology — Plex, Sonarr, Radarr, Home Assistant</span>
            </li>
            <li>
              <span class="uses-hw-label">Shell</span>
              <span class="uses-hw-value">Zsh · Homebrew · pnpm · Claude Code</span>
            </li>
          </ul>
        </div>
      </div>
    </RevealOnScroll>
  </section>
</BaseLayout>

<style>
  /* ─── Intro ─────────────────────────────────────────────── */

  .uses-intro {
    max-width: 860px;
    margin: 0 auto;
  }

  .uses-heading {
    margin-bottom: 1.5rem;
  }

  .uses-h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: 0.02em;
    color: var(--ink-100);
    margin: 0.3rem 0 0;
  }

  .uses-h1--carved {
    text-shadow:
      0 2px 0 rgba(0, 0, 0, 0.8),
      0 -1px 0 rgba(240, 185, 11, 0.08);
  }

  .uses-lede {
    color: var(--ink-300);
    font-size: 1.05rem;
    line-height: 1.65;
    max-width: 52rem;
    margin: 0;
  }

  /* ─── Monument (shared with /about /work) ────────────────── */

  .monument {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .monument-frieze {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--ink-700);
  }

  .monument-frieze::before,
  .monument-frieze::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(
      to var(--monument-dir, right),
      transparent,
      rgba(240, 185, 11, 0.2)
    );
  }

  .monument-frieze--top { --monument-dir: right; }
  .monument-frieze--bottom { --monument-dir: left; }

  .monument-rune {
    font-size: 0.9rem;
    opacity: 0.5;
  }

  /* ─── Grid outer ─────────────────────────────────────────── */

  .uses-grid-outer {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-bottom: 3rem;
  }

  /* ─── Category header ────────────────────────────────────── */

  .uses-cat-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .uses-cat-rune {
    font-size: 1.4rem;
    color: var(--gold-400);
    line-height: 1;
    margin-top: 0.25rem;
    flex-shrink: 0;
  }

  .uses-cat-title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    color: var(--ink-100);
    margin: 0.15rem 0 0;
    letter-spacing: 0.02em;
  }

  /* ─── Tool grid ──────────────────────────────────────────── */

  .uses-tool-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.75rem;
  }

  /* ─── Tool card ──────────────────────────────────────────── */

  .uses-tool-card {
    position: relative;
    background: var(--bg-ember);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-top: 2px solid var(--rarity-color, rgba(255, 255, 255, 0.15));
    border-radius: 2px;
    padding: 1rem 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .uses-tool-card:hover {
    transform: translateY(-1px);
    border-color: rgba(255, 255, 255, 0.12);
    border-top-color: var(--rarity-color, rgba(255, 255, 255, 0.3));
  }

  /* rarity color via data attribute */
  .uses-tool-card[data-rarity='common']    { --rarity-color: var(--rarity-common); }
  .uses-tool-card[data-rarity='uncommon']  { --rarity-color: var(--rarity-uncommon); }
  .uses-tool-card[data-rarity='rare']      { --rarity-color: var(--rarity-rare); }
  .uses-tool-card[data-rarity='epic']      { --rarity-color: var(--rarity-epic); }
  .uses-tool-card[data-rarity='legendary'] { --rarity-color: var(--rarity-legendary); }
  .uses-tool-card[data-rarity='artifact']  { --rarity-color: var(--rarity-artifact); }

  .uses-tool-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .uses-tool-name-row {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .uses-tool-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink-100);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: color 150ms ease;
  }

  a.uses-tool-name:hover {
    color: var(--gold-300);
  }

  .uses-tool-note {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink-500);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .uses-tool-desc {
    font-size: 0.83rem;
    color: var(--ink-500);
    line-height: 1.55;
    margin: 0;
    flex: 1;
  }

  .uses-rarity-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--rarity-color);
    opacity: 0.7;
    margin-top: auto;
  }

  /* ─── Tier badge ─────────────────────────────────────────── */

  .uses-tier {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2em 0.5em;
    border-radius: 2px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .tier--mastered {
    background: rgba(240, 185, 11, 0.12);
    color: var(--gold-300);
    border: 1px solid rgba(240, 185, 11, 0.25);
  }

  .tier--daily {
    background: rgba(163, 53, 238, 0.1);
    color: var(--rarity-epic);
    border: 1px solid rgba(163, 53, 238, 0.2);
  }

  .tier--regular {
    background: rgba(255, 255, 255, 0.04);
    color: var(--ink-500);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tier--learning {
    background: rgba(0, 112, 221, 0.1);
    color: var(--rarity-rare);
    border: 1px solid rgba(0, 112, 221, 0.2);
  }

  /* ─── Hardware callout ───────────────────────────────────── */

  .uses-hardware-section {
    max-width: 760px;
    margin: 0 auto;
  }

  .uses-hardware-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: linear-gradient(
      135deg,
      rgba(240, 185, 11, 0.04) 0%,
      rgba(13, 12, 20, 0) 60%
    );
    border: 1px solid rgba(240, 185, 11, 0.15);
    border-radius: 2px;
    padding: 2rem;
  }

  .uses-hardware-rune {
    font-size: 2rem;
    color: var(--gold-400);
    opacity: 0.6;
    flex-shrink: 0;
    line-height: 1;
    margin-top: 0.15rem;
  }

  .uses-hardware-title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    color: var(--ink-100);
    margin: 0.2rem 0 1.25rem;
    letter-spacing: 0.02em;
  }

  .uses-hardware-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .uses-hardware-list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    font-size: 0.9rem;
  }

  .uses-hw-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-400);
    width: 3.5rem;
    flex-shrink: 0;
  }

  .uses-hw-value {
    color: var(--ink-300);
    line-height: 1.4;
  }

  /* ─── section-eyebrow (shared token) ────────────────────── */

  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin: 0 0 0.35rem;
  }
</style>
